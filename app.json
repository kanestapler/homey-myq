            "name": "image",
            "type": "image",
            "title": {
              "en": "Recording"
            }
          },
          {
            "name": "people",
            "type": "number",
            "title": {
              "en": "People"
            },
            "example": 0
          },
          {
            "name": "vehicles",
            "type": "number",
            "title": {
              "en": "Vehicles"
            },
            "example": 1
          }
        ],
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=camera"
          }
        ]
      },
      {
