            "name": "image",
            "type": "image",
            "title": {
              "en": "Recording"
            }
          },
          {
            "name": "people",
            "type": "number",
            "title": {
              "en": "People"
            },
            "example": 1
          },
          {
            "name": "vehicles",
            "type": "number",
            "title": {
              "en": "Vehicles"
            },
            "example": 0
          }
        ],
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=camera"
          }
