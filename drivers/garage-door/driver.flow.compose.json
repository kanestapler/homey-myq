      "id": "door_opening",
      "title": {
        "en": "Started opening"
      }
    },
    {
      "id": "door_closing",
      "title": {
        "en": "Started closing"
      }
    },
    {
      "id": "door_open_for",
      "title": {
        "en": "Has been open for a number of minutes"
      },
      "titleFormatted": {
        "en": "Has been open for [[minutes]] minutes"
      },
      "hint": {
        "en": "Fires once each time the door is left open this long. The count starts when the door leaves the closed position and starts again when it is fully closed. Checked every 15 seconds."
      },
      "args": [
        {
          "name": "minutes",
          "type": "number",
          "title": { "en": "Minutes" },
          "placeholder": { "en": "30" },
          "min": 1,
          "max": 1440,
          "step": 1
        }
      ],
      "tokens": [
        {
          "name": "minutes",
          "type": "number",
          "title": { "en": "Minutes open" },
          "example": 30
        }
      ]
    }
  ],
  "conditions": [
    {
      "id": "door_state_is",
      "title": {
        "en": "Door state !{{is|isn't}}"
      },
      "titleFormatted": {
        "en": "Door state !{{is|isn't}} [[state]]"
      },
      "args": [
        {
          "name": "state",
          "type": "dropdown",
          "title": {
            "en": "State"
          },
          "values": [
            { "id": "open", "title": { "en": "Open" } },
            { "id": "closed", "title": { "en": "Closed" } },
            { "id": "opening", "title": { "en": "Opening" } },
            { "id": "closing", "title": { "en": "Closing" } },
            { "id": "stopped", "title": { "en": "Stopped" } }
          ]
        }
      ]
    }
  ]
